#!/usr/bin/osascript -l JavaScript
// Magnet をやめても右 1/3 に寄せられるよう、最前面ウィンドウを今いるモニターの右 1/3 に置く
// 座標を決め打ちしないのは、ノートやモバイルモニターでも同じキーで使いたいため
ObjC.import('AppKit')

function run() {
  const proc = Application('System Events').processes.whose({ frontmost: true })[0]
  const win = proc.windows[0]
  const [wx, wy] = win.position()

  // NSScreen は左下原点、System Events はメイン画面の左上原点なので揃える
  const screens = $.NSScreen.screens
  const mainHeight = screens.objectAtIndex(0).frame.size.height
  let area
  for (let i = 0; i < screens.count; i++) {
    const f = screens.objectAtIndex(i).frame
    const v = screens.objectAtIndex(i).visibleFrame
    const top = mainHeight - (f.origin.y + f.size.height)
    if (wx >= f.origin.x && wx < f.origin.x + f.size.width && wy >= top && wy < top + f.size.height) {
      area = { x: v.origin.x, y: mainHeight - (v.origin.y + v.size.height), w: v.size.width, h: v.size.height }
      break
    }
  }
  if (!area) return

  const w = Math.round(area.w / 3)
  const pos = [Math.round(area.x + area.w - w), Math.round(area.y)]
  // 先に size だけ変えると画面外にはみ出して縮められるアプリがあるため、position で挟む
  win.position = pos
  win.size = [w, Math.round(area.h)]
  win.position = pos
}
