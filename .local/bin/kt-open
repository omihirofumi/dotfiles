#!/bin/zsh -l
# kitty のセッションをプロジェクトとして選び、そのタブ群に切り替える (zellij 用の zj-open の kitty 版)
#   kt-open           Ctrl j s の一時タブから。終わればタブが閉じる
#   kt-open --startup kitty 起動時の最初のタブから。選べばこのタブは閉じ、Esc なら普通のシェルとして残す
# セッションファイルは仕事のパスを含むので、公開している dotfiles ではなく手元に置く
sessions=~/.local/share/kitty-sessions
cache=~/.cache/kitty-sessions
mkdir -p $sessions $cache

# 起動時のタブはどのセッションにも属さずタブバーに残るので、選び終えたら終了して閉じる
fallback() {
  [[ $1 == --startup ]] && exec zsh -l
  exit
}

# セッションには番号を振り、数字キー 1 打で開けるようにする。表示と戻り値はタブで分ける
names=($sessions/*.kitty-session(N:t:r))
lines=() binds=()
# {1..0} は 1 0 に展開されるので、セッションが無いときに回らない書き方にする
for (( i = 1; i <= $#names; i++ )); do
  lines+="$i ${names[i]}"$'\t'"session:${names[i]}"
  # pos(n) は絞り込み後の n 番目を指し表示番号とずれるので、番号ごとに戻り値を直接埋め込む
  (( i <= 9 )) && binds+="$i:become(echo session:${names[i]})"
done
for dir in ${(f)"$(zoxide query -l)"}; do
  lines+="  ${dir/#$HOME/~}"$'\t'"$dir"
done
# 空の --bind は fzf がエラーで落ちるため、割り当てがあるときだけ渡す
opts=(--prompt 'project> ' --delimiter '\t' --with-nth 1 --accept-nth 2)
(( $#binds )) && opts+=(--bind "${(j:,:)binds}")
pick=$(print -rl -- $lines | fzf $opts)
[ -z "$pick" ] && fallback "$1"

if [[ $pick == session:* ]]; then
  file=$sessions/${pick#session:}.kitty-session
else
  name=$(basename "$pick" | tr . _)
  file=$cache/$name.kitty-session
  # zoxide のディレクトリにはセッションファイルが無いので、1 タブだけのものをその場で作る
  printf 'new_tab %s\ncd %s\nlaunch\n' "$name" "$pick" > $file
fi

# overlay は終了するとすぐ閉じるので、失敗したときはエラーを読めるよう待つ
if ! kitten @ action goto_session "$file"; then
  echo 'kitten @ に失敗。kitty を再起動して listen_on を読み込ませる'
  read -r
  fallback "$1"
fi
