#!/bin/sh
set -eu

file="$HOME/journal/todo.md"
heading="## $(date +%F)"
mkdir -p "$(dirname "$file")"
touch "$file"

if [ "$(grep '^## ' "$file" | tail -n 1)" != "$heading" ]; then
  [ -s "$file" ] && printf '\n' >>"$file"
  printf '%s\n\n' "$heading" >>"$file"
fi

exec hx "$file:$(($(wc -l <"$file")))"
