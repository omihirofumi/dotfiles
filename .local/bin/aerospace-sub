#!/bin/sh
# 右 1/3 のサブ(floating を何枚も重ねる)とメイン(タイル)を行き来する
#   toggle: メインなら最後に見ていたサブへ、サブなら最後に見ていたメインへ
#   cycle:  サブの中を順に巡回する
#   record: on-focus-changed から呼ばれ、メインとサブそれぞれ最後に見ていたものを覚える
# focus right は floating の並び順が見た目と一致せず、タイル間の移動中にサブへ飛んでしまうため専用にしている
# focus-back-and-forth で戻らないのは、サブ内を巡回すると直前が別のサブになるため
# exec-and-forget は launchd の PATH で動き Homebrew が見えない
PATH=/opt/homebrew/bin:$PATH
state=~/.cache/aerospace

windows() {
  # 隠れているアプリのウィンドウ(macos_native_window_of_hidden_app)はどちらにも含めない
  aerospace list-windows --workspace focused --format '%{window-id} %{window-layout}' |
    awk -v want="$1" '(want == "sub" && $2 == "floating") || (want == "main" && $2 ~ /tiles|accordion/) { print $1 }'
}

focused() {
  aerospace list-windows --focused --format "%{window-$1}"
}

side() {
  [ "$(focused layout)" = floating ] && echo sub || echo main
}

# 記録が今の workspace に残っていればそれを、無ければ先頭を開く
focus_last() {
  ids=$(windows "$1")
  last=$(cat "$state/$1-last" 2>/dev/null)
  if [ -n "$last" ] && echo "$ids" | grep -qx "$last"; then
    exec aerospace focus --window-id "$last"
  fi
  first=$(echo "$ids" | head -1)
  [ -n "$first" ] && exec aerospace focus --window-id "$first"
}

case $1 in
  record)
    id=$(focused id)
    [ -n "$id" ] || exit 0
    mkdir -p "$state"
    prev=$(cat "$state/prev" 2>/dev/null)
    echo "$id" > "$state/prev"
    # サブを閉じると AeroSpace は最後に見ていたメインではなく accordion の別のウィンドウを選ぶことがある
    # 閉じたときのフックは無いので、閉じた直後のフォーカス変化で検知して戻す
    if [ "$(side)" = main ] && [ -n "$prev" ] && [ "$prev" = "$(cat "$state/sub-last" 2>/dev/null)" ] &&
      ! aerospace list-windows --all --format '%{window-id}' | grep -qx "$prev"; then
      main=$(cat "$state/main-last" 2>/dev/null)
      if [ -n "$main" ] && [ "$main" != "$id" ] && windows main | grep -qx "$main"; then
        exec aerospace focus --window-id "$main"
      fi
    fi
    echo "$id" > "$state/$(side)-last"
    ;;
  toggle)
    [ "$(side)" = sub ] && focus_last main || focus_last sub
    ;;
  cycle)
    ids=$(windows sub)
    [ -n "$ids" ] || exit 0
    next=$(echo "$ids" | awk -v cur="$(focused id)" 'found { print; exit } $1 == cur { found = 1 }')
    # 末尾にいるときやメインにいるときは次が無いので先頭へ
    [ -n "$next" ] || next=$(echo "$ids" | head -1)
    exec aerospace focus --window-id "$next"
    ;;
esac
