#!/bin/sh
# メイン(タイル)と右 1/3 のサブ(floating)を往復する
# focus right は floating の並び順が見た目と一致せず、タイル間の移動中にサブへ飛んでしまうため専用にしている
# exec-and-forget は launchd の PATH で動き Homebrew が見えない
PATH=/opt/homebrew/bin:$PATH

if [ "$(aerospace list-windows --focused --format '%{window-layout}')" = floating ]; then
  exec aerospace focus-back-and-forth
fi

sub=$(aerospace list-windows --workspace focused --format '%{window-id} %{window-layout}' | awk '$2 == "floating" { print $1; exit }')
[ -n "$sub" ] && exec aerospace focus --window-id "$sub"
